{
  "name": "mad-football",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Mad Football - 2D no-rules arcade football for mobile",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "sim": "tsx --import ./tools/sim-shim.mjs tools/sim.ts",
    "smoke": "tsx --import ./tools/sim-shim.mjs tools/humantest.ts",
    "career": "tsx --import ./tools/sim-shim.mjs tools/careersim.ts",
    "career-match": "tsx --import ./tools/sim-shim.mjs tools/careermatch.ts",
    "android": "npm run build && cap sync android",
    "sim:slide": "tsx --import ./tools/sim-shim.mjs tools/slidebot.ts",
    "sim:gk": "tsx --import ./tools/sim-shim.mjs tools/gktest.ts"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/local-notifications": "^8.3.1",
    "@fontsource/oswald": "^5.3.0",
    "@fontsource/permanent-marker": "^5.3.0",
    "@fontsource/pixelify-sans": "^5.3.0",
    "@fontsource/press-start-2p": "^5.3.0",
    "@fontsource/roboto-condensed": "^5.3.0"
  }
}
